DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://omniedu:omniedu@127.0.0.1:5432/omniedu
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Email -------------------------------------------------------------------------------------
# Default: emails are only printed in the backend terminal, and invitation links are shown on screen.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OmniEducation <no-reply@omniedu.app>

# Real emails through Gmail: turn on 2-Step Verification for the Google account, create an
# "App password" (Google Account > Security > App passwords), then replace the two lines above with:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=the-16-character-app-password
# DEFAULT_FROM_EMAIL=OmniEducation <your.address@gmail.com>
# Links in the emails use FRONTEND_URL, so it must be an address the recipient can open
# (http://localhost only works on this computer).
