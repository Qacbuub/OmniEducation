# Copy to .env.prod and change every value marked CHANGE ME. Never commit .env.prod.

# --- Database (used by the db container and the backend) ---
POSTGRES_DB=omniedu
POSTGRES_USER=omniedu
POSTGRES_PASSWORD=CHANGE-ME-long-random-password

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The address people open in the browser (used in invitation and password-reset links).
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

# Local deployment over plain HTTP: keep these false. With a certificate (HTTPS) set both to true.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# Load the demo school and university (20 demo accounts, password Demo@1234) on the first start.
SEED_DEMO=true

# --- Email: console prints emails to the backend log. For real email use SMTP settings. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OmniEducation <no-reply@omniedu.app>
# Show invitation links in the admin screens (only sensible while emails are not really sent).
SHOW_INVITE_LINKS=true
